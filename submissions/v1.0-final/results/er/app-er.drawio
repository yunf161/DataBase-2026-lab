        <mxCell id="label-A03" value="A03 归属记录 0..1 / 1..1**" vertex="1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=#f8fbfd;strokeColor=none;whiteSpace=wrap;">
          <mxGeometry x="620" y="563" width="300" height="30" as="geometry" />
